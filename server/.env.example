PGHOST=localhost
PGPORT=5432
PGDATABASE=ntou_events
PGUSER=postgres
PGPASSWORD="請填入自己的資料庫密碼"
JWT_SECRET="請填入自己產生的隨機密鑰"
PORT=8000

# 必須由小組確認正式網域；以下僅為獨立測試網域。
ALLOWED_CAMPUS_EMAIL_DOMAINS=campus.example
EMAIL_VERIFICATION_TTL_MINUTES=1440
PUBLIC_APP_URL=http://127.0.0.1:8000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=events@campus.example

# PORT 可自訂；PUBLIC_APP_URL 必須填實際前端 origin，兩者請同步。
HOST=127.0.0.1
# 正式校園網域、SMTP 主機／寄件者由團隊提供；範例只供隔離測試。
