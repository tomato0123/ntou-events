{
  "name": "ntou-events-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "活動報名與結果確認 REST API（純 JavaScript 後端）",
  "engines": { "node": ">=24.12.0 <25" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "node --test tests/*.test.js",
    "example": "node scripts/example.js"
  }
}
